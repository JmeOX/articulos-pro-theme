{%- comment -%}
  ap-why — "Por qué Artículos Pro": tarjetas con ícono, título y texto (bloques editables).
{%- endcomment -%}
<div class="ap-sec color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% render 'ap-sec-head', eyebrow: section.settings.eyebrow, title: section.settings.title %}
    <div class="ap-why">
      {%- for block in section.blocks -%}
        <div class="ap-card ap-why__card" {{ block.shopify_attributes }}>
          <span class="ap-why__ic"><svg class="ap-ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}<path d="M2 7h12v10H2zM14 10h4l4 4v3h-8z"/>
              {%- when 'chat' -%}<path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z"/>
              {%- when 'arrow' -%}<path d="M5 19L19 5M9 5h10v10"/>
              {%- else -%}<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>
            {%- endcase -%}
          </svg></span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "AP · Por qué nosotros",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Por qué Artículos Pro" },
    { "type": "text", "id": "title", "label": "Título", "default": "Compras con respaldo" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" }
  ],
  "blocks": [{ "type": "item", "name": "Razón", "settings": [
    { "type": "select", "id": "icon", "label": "Ícono", "default": "shield", "options": [
      { "value": "shield", "label": "Escudo" }, { "value": "truck", "label": "Camión" }, { "value": "chat", "label": "Chat" }, { "value": "arrow", "label": "Flecha" } ] },
    { "type": "text", "id": "title", "label": "Título", "default": "Calidad garantizada" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "1 mes de garantía. Si tu producto falla, te respondemos." }
  ] }],
  "presets": [{ "name": "AP · Por qué nosotros", "blocks": [
    { "type": "item", "settings": { "icon": "shield", "title": "Calidad garantizada", "text": "1 mes de garantía. Si tu producto falla, te respondemos." } },
    { "type": "item", "settings": { "icon": "truck", "title": "Entrega garantizada", "text": "Hacemos seguimiento a tu pedido hasta que llegue." } },
    { "type": "item", "settings": { "icon": "chat", "title": "Soporte siempre", "text": "Te asesoramos por WhatsApp antes y después de comprar." } },
    { "type": "item", "settings": { "icon": "arrow", "title": "No es lo del montón", "text": "Productos útiles a precios accesibles, que no encuentras en cualquier tienda." } }
  ] }]
}
{% endschema %}
