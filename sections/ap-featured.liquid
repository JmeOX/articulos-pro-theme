{%- comment -%}
  ap-featured — rejilla de productos destacados de una colección, con la tarjeta de producto del tema.
{%- endcomment -%}
{%- assign c = section.settings.collection -%}
<div class="ap-sec color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% render 'ap-sec-head', eyebrow: section.settings.eyebrow, title: section.settings.title %}
    <ul class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop ap-featured" role="list">
      {%- for product in c.products limit: section.settings.limit -%}
        <li class="grid__item">{% render 'card-product', card_product: product, media_aspect_ratio: 'square', image_shape: 'default', show_secondary_image: false, show_vendor: false, show_rating: true, section_id: section.id %}</li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.button != blank -%}<p class="ap-featured__more"><a class="ap-btn ap-btn--secondary" href="{{ section.settings.button_link | default: c.url }}">{{ section.settings.button }}</a></p>{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "AP · Destacados",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Cantidad de productos", "min": 2, "max": 12, "step": 2, "default": 4 },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Destacados" },
    { "type": "text", "id": "title", "label": "Título", "default": "Los más elegidos" },
    { "type": "text", "id": "button", "label": "Botón", "default": "Ver todos los productos" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón", "default": "/collections/all" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-2" }
  ],
  "presets": [{ "name": "AP · Destacados" }]
}
{% endschema %}
