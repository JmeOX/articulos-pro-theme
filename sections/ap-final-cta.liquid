{%- comment -%}
  ap-final-cta — último llamado al final de la página de producto + barra fija de compra.
  - Último llamado: foto, nombre, precio y los dos botones (comprar / WhatsApp).
  - Barra fija: aparece abajo cuando el botón principal sale de la pantalla y se oculta
    cuando el último llamado está visible (para no repetir botones).
  Los botones "Comprar ahora" hacen clic en el botón real de Dawn, así se agrega
  el paquete elegido y se abre el carrito lateral.
{%- endcomment -%}
{%- assign ap_v = product.selected_or_first_available_variant -%}
<div class="ap-sec color-{{ section.settings.color_scheme }} gradient" data-ap-final>
  <div class="page-width ap-final">
    <div class="ap-final__prod">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 240 | image_tag: class: 'ap-final__img', loading: 'lazy', alt: product.title }}
      {%- endif -%}
      <div>
        <p class="ap-final__title">{{ product.title }}</p>
        <p class="ap-final__price">
          <span data-ap-price-mirror>{{ ap_v.price | money_without_trailing_zeros }}</span>
          <s class="ap-old" data-ap-old-mirror{% unless ap_v.compare_at_price > ap_v.price %} hidden{% endunless %}>{{ ap_v.compare_at_price | money_without_trailing_zeros }}</s>
        </p>
      </div>
    </div>
    <button type="button" class="ap-btn ap-btn--primary ap-final__buy" data-ap-buy>{{ section.settings.button_label }}</button>
    {% render 'ap-whatsapp-button', product: product %}
  </div>
</div>

{%- if settings.ap_anim_scroll -%}
  <button type="button" class="ap-scroll-cue" data-ap-scroll-cue aria-label="Ver más información del producto" hidden>
    <span>Desliza para ver más</span>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
  </button>
{%- endif -%}

{%- if section.settings.show_sticky -%}
  <div class="ap-sticky" data-ap-sticky aria-hidden="true">
    <div class="page-width ap-sticky__in">
      <div class="ap-sticky__prod">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 120 | image_tag: class: 'ap-sticky__img', loading: 'lazy', alt: product.title }}
        {%- endif -%}
        <div class="ap-sticky__info">
          <b>{{ product.title }}</b>
          <span class="ap-sticky__price">
            <span data-ap-price-mirror>{{ ap_v.price | money_without_trailing_zeros }}</span>
            <s class="ap-old" data-ap-old-mirror{% unless ap_v.compare_at_price > ap_v.price %} hidden{% endunless %}>{{ ap_v.compare_at_price | money_without_trailing_zeros }}</s>
          </span>
        </div>
      </div>
      <button type="button" class="ap-btn ap-btn--primary" data-ap-buy tabindex="-1">{{ section.settings.button_label }}</button>
    </div>
  </div>
{%- endif -%}

<script>
  (() => {
    const mainBtn = () => document.querySelector('product-form .product-form__submit');
    const priceNow = () => document.querySelector('.ap-price__now');

    // "Comprar ahora" del último llamado y de la barra fija → botón real de Dawn
    document.querySelectorAll('[data-ap-buy]').forEach((b) => b.addEventListener('click', () => {
      const btn = mainBtn();
      if (btn && !btn.disabled) btn.click();
      else document.getElementById('MainContent').scrollIntoView({ behavior: 'smooth' });
    }));

    // Mantener el precio igual al del paquete elegido
    const syncPrice = () => {
      const p = priceNow();
      if (p) document.querySelectorAll('[data-ap-price-mirror]').forEach((el) => { el.textContent = p.textContent.trim(); });
      const old = document.querySelector('.ap-price .ap-price__old');
      document.querySelectorAll('[data-ap-old-mirror]').forEach((el) => {
        el.hidden = !old;
        if (old) el.textContent = old.textContent.trim();
      });
    };
    document.addEventListener('ap:pack-change', () => setTimeout(syncPrice, 1200));

    // Indicador "Desliza para ver más": solo visible arriba del todo de la página
    const cue = document.querySelector('[data-ap-scroll-cue]');
    if (cue) {
      const atTop = () => window.scrollY < 40 && document.documentElement.scrollHeight > window.innerHeight * 1.5;
      const setCue = () => { const on = atTop(); cue.hidden = false; cue.classList.toggle('is-on', on); cue.tabIndex = on ? 0 : -1; };
      cue.addEventListener('click', () => window.scrollBy({ top: window.innerHeight * 0.8, behavior: 'smooth' }));
      window.addEventListener('scroll', setCue, { passive: true });
      window.addEventListener('resize', setCue);
      setTimeout(setCue, 600);
    }

    // Mostrar la barra fija solo entre el botón principal y el último llamado
    const sticky = document.querySelector('[data-ap-sticky]');
    const final = document.querySelector('[data-ap-final]');
    if (!sticky) return;
    let ticking = false;
    const update = () => {
      ticking = false;
      const btn = mainBtn();
      const vh = window.innerHeight;
      // Botón principal ya pasó (quedó arriba de la pantalla)
      const passedMain = btn ? btn.getBoundingClientRect().bottom < 0 : false;
      // Último llamado visible en pantalla
      const fr = final ? final.getBoundingClientRect() : null;
      const finalVisible = fr ? fr.top < vh && fr.bottom > 0 : false;
      const show = passedMain && !finalVisible;
      if (show === sticky.classList.contains('is-on')) return;
      sticky.classList.toggle('is-on', show);
      sticky.setAttribute('aria-hidden', String(!show));
      sticky.querySelector('button').tabIndex = show ? 0 : -1;
      document.body.classList.toggle('ap-sticky-on', show);
      if (show) syncPrice();
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "AP · Último llamado",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Comprar ahora" },
    { "type": "checkbox", "id": "show_sticky", "label": "Mostrar barra fija de compra en el celular y escritorio", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-2" }
  ],
  "presets": [{ "name": "AP · Último llamado" }]
}
{% endschema %}
