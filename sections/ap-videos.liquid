{%- comment -%}
  ap-videos — carrusel horizontal de videos verticales de clientes.
  Dato: metacampo artpro.videos (lista de archivos de video).
{%- endcomment -%}
{%- assign ap_videos = product.metafields.artpro.videos.value -%}
{%- if ap_videos != blank -%}
<div class="ap-sec color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% render 'ap-sec-head', eyebrow: section.settings.eyebrow, title: section.settings.title %}
    <div class="ap-vids">
      {%- for v in ap_videos -%}
        {%- if v.media_type == 'video' -%}
          <div class="ap-vids__item" data-ap-vid>
            <span class="ap-vids__tag">{{ section.settings.tag }}</span>
            {{ v | video_tag: playsinline: true, preload: 'metadata', image_size: '600x' }}
            <button type="button" class="ap-vids__play" aria-label="Reproducir video {{ forloop.index }}">
              <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
            </button>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
<script>
  // Toca un video para reproducirlo (con sonido); se pausa el que estuviera sonando.
  // Volver a tocarlo lo pausa. Así cada video funciona igual, sin depender de los controles nativos.
  (() => {
    const root = document.currentScript.previousElementSibling;
    const items = root.querySelectorAll('[data-ap-vid]');
    items.forEach((item) => {
      const video = item.querySelector('video');
      item.addEventListener('click', () => {
        if (video.paused) {
          items.forEach((other) => { const v = other.querySelector('video'); if (v !== video) { v.pause(); other.classList.remove('is-playing'); } });
          video.muted = false;
          video.play().then(() => item.classList.add('is-playing')).catch(() => { video.muted = true; video.play(); item.classList.add('is-playing'); });
        } else {
          video.pause();
          item.classList.remove('is-playing');
        }
      });
      video.addEventListener('ended', () => item.classList.remove('is-playing'));
    });
  })();
</script>
{%- endif -%}
{% schema %}
{
  "name": "AP · Videos de clientes",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Clientes reales" },
    { "type": "text", "id": "title", "label": "Título", "default": "Así lo usan en casa" },
    { "type": "text", "id": "tag", "label": "Etiqueta sobre cada video", "default": "CLIENTE REAL" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-2" }
  ],
  "presets": [{ "name": "AP · Videos de clientes" }]
}
{% endschema %}
