{%- comment -%}
  ap-faq — preguntas frecuentes en acordeón (sin JavaScript, con <details>).
  Dato: artpro.faqs (lista "Pregunta | Respuesta"). Vacío = sección oculta.
{%- endcomment -%}
{%- assign ap_mf = product.metafields.artpro.faqs -%}
{%- if ap_mf.type contains 'list' -%}{%- assign ap_items = ap_mf.value -%}{%- else -%}{%- assign ap_items = ap_mf.value | split: ';' -%}{%- endif -%}
{%- if ap_items != blank -%}
<div class="ap-sec color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width ap-narrow">
    {% render 'ap-sec-head', eyebrow: section.settings.eyebrow, title: section.settings.title %}
    <div class="ap-faq">
      {%- for item in ap_items -%}
        {%- assign q = item | split: '|' | first -%}
        <details class="ap-fq">
          <summary>{{ q | strip }}<span aria-hidden="true">+</span></summary>
          <p>{{ item | remove_first: q | remove_first: '|' | strip }}</p>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "AP · Preguntas frecuentes",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Preguntas frecuentes" },
    { "type": "text", "id": "title", "label": "Título", "default": "Resolvemos tus dudas" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" }
  ],
  "presets": [{ "name": "AP · Preguntas frecuentes" }]
}
{% endschema %}
