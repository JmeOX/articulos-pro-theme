{%- comment -%}
  ap-pack-picker — tarjetas de paquete (1, 2 o 3 unidades) con precio y precio tachado.
  Solo se usa si el producto tiene UNA opción (ej. "Paquete"); si tiene más, no se muestra
  y queda el selector normal de Dawn.
  Funciona como "control remoto": al tocar una tarjeta, hace clic en el selector oculto de Dawn,
  así Dawn sigue actualizando precio, foto, botón y URL como siempre.
{%- endcomment -%}
{%- if product.options.size == 1 and product.variants.size > 1 -%}
  <div class="ap-pack" data-ap-pack>
    <p class="ap-pack__label">Elige tu {{ product.options.first | downcase }}</p>
    {%- for variant in product.variants -%}
      <button type="button"
        class="ap-pack__opt{% if variant == product.selected_or_first_available_variant %} is-on{% endif %}"
        data-value="{{ variant.option1 | escape }}"
        {% unless variant.available %}disabled{% endunless %}>
        <span class="ap-pack__radio" aria-hidden="true"></span>
        <span class="ap-pack__name">{{ variant.option1 }}{% unless variant.available %} · Agotado{% endunless %}</span>
        <span class="ap-pack__price">
          {{ variant.price | money_without_trailing_zeros }}
          {%- if variant.compare_at_price > variant.price -%}
            <s>{{ variant.compare_at_price | money_without_trailing_zeros }}</s>
          {%- endif -%}
        </span>
      </button>
    {%- endfor -%}
  </div>
  <script>
    (() => {
      const root = document.currentScript.previousElementSibling;
      const info = root.closest('.product__info-container') || document;
      // Al tocar una tarjeta: marcarla y hacer clic en la opción equivalente de Dawn
      root.addEventListener('click', (e) => {
        const btn = e.target.closest('.ap-pack__opt');
        if (!btn || btn.disabled) return;
        root.querySelectorAll('.ap-pack__opt').forEach((b) => b.classList.toggle('is-on', b === btn));
        const input = [...info.querySelectorAll('variant-selects input[type="radio"]')].find((i) => i.value === btn.dataset.value);
        if (input && !input.checked) input.click();
        document.dispatchEvent(new CustomEvent('ap:pack-change', { detail: { value: btn.dataset.value } }));
      });
    })();
  </script>
{%- endif -%}
