{%- comment -%}
  ap-cart-pack — en el carrito, reemplaza los botones + / − por el selector de paquete (1, 2, 3 unidades).
  Solo para productos con UNA opción y varias variantes. Al tocar otro paquete, ap-cart.js
  cambia la variante de esa línea (quita la vieja y agrega la nueva).
{%- endcomment -%}
<div class="ap-cart-pack" role="group" aria-label="Cambiar {{ item.product.options.first | downcase }}">
  {%- for v in item.product.variants -%}
    <button type="button"
      class="ap-cart-pack__btn{% if v.id == item.variant_id %} is-on{% endif %}"
      data-ap-pack-from="{{ item.key }}"
      data-ap-pack-to="{{ v.id }}"
      {% if v.id == item.variant_id or v.available == false %}disabled{% endif %}>
      {{ v.option1 }}
    </button>
  {%- endfor -%}
</div>
{%- comment -%} Botón para eliminar la línea: usa el mismo componente de Dawn (cart-remove-button) {%- endcomment -%}
<input type="hidden" id="Drawer-quantity-{{ item.index | plus: 1 }}" value="{{ item.quantity }}" data-quantity-variant-id="{{ item.variant.id }}" data-quantity-line-key="{{ item.key }}">
<cart-remove-button id="CartDrawer-Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
  <button type="button" class="ap-cart-remove" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}" data-variant-id="{{ item.variant.id }}">
    <span class="svg-wrapper" aria-hidden="true">{{- 'icon-remove.svg' | inline_asset_content -}}</span>
    Eliminar
  </button>
</cart-remove-button>
